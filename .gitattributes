# =============================================================================
# 交付目标为 Linux（Ubuntu 22.04 / ROS2 Humble）：文本统一 LF，杜绝 CRLF 破坏 shebang
# 背景：Windows 上 core.autocrlf=true 时，检出会把 .sh 变成 CRLF，
#       在 Linux 上执行报 "/usr/bin/env: 'bash\r': No such file or directory"，
#       且错误信息不指向换行符问题，排查成本高。
# =============================================================================

# 默认：交给 Git 自动判断文本/二进制，仓库内统一存 LF
* text=auto

# 脚本与可执行配置：强制 LF（检出也是 LF，不随 autocrlf 变）
.gitattributes text eol=lf
.gitignore     text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
postinst    text eol=lf
prerm       text eol=lf
preinst     text eol=lf
postrm      text eol=lf
*.service   text eol=lf
*.launch.py text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.repos     text eol=lf
*.rviz      text eol=lf
CMakeLists.txt text eol=lf
*.cmake     text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.env       text eol=lf
*.conf      text eol=lf

# 明确二进制：不做任何换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.jar  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.bag  binary
*.pgm  binary
*.png  binary
*.db   binary
*.deb  binary
*.pcd  -text
*.ply  -text
