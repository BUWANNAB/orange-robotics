# Copy to ~/.config/orange-agv/runtime.env and replace every site-specific value.
# Keep this file private (chmod 600). Do not commit the populated file.
ROBOT_APP_DIR=/opt/orange
ROBOT_NAV_WS=/opt/orange/ros/orange_nav_ws
PYTHON_VENV=/opt/orange/.venv
ROBOT_WEB_HOST=0.0.0.0
ROBOT_WEB_PORT=8097
ROBOT_DB_HOST=127.0.0.1
ROBOT_DB_PORT=3306
ROBOT_DB_USER=orange
ROBOT_DB_PASSWORD=CHANGE_ME
ROBOT_DB_NAME=orange_fresh
JWT_SECRET=CHANGE_TO_RANDOM_64_CHARACTERS
ROBOT_PCD_DIR=/var/lib/orange/pcd
ROBOT_MAP_DIR=/var/lib/orange/maps
PCD_PROCESSOR_EXECUTABLE=/opt/orange/ros/orange_nav_ws/install/pcd2pgm/lib/pcd2pgm/map_asset_processor
ORANGE_DATA_DIR=/var/lib/orange
ROBOT_FILES_DIR=/var/lib/orange/files
ROBOT_STATIC_MAPS_DIR=/var/lib/orange/static-maps
RCS_DATA_DIR=/var/lib/orange/rcs
# Shared writable JSON read by Web and ROS; initialize it from the correct sensor template.
MID360_CONFIG_FILE=/var/lib/orange/lidar/active.json
ROBOT_PLC_HOST=CHANGE_TO_VERIFIED_PLC_IP
ROBOT_PLC_PORT=502
ROBOT_PLC_PROTOCOL=UNVERIFIED
RCS_ROS_CONTROL_ENABLED=false
# Set after the robot is registered in the Web UI, then restart orange-web.service.
# RCS_LOCAL_ROBOT_ID=1
