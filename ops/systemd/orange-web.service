[Unit]
Description=Orange Python RCS/RDS Web and ROS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/orange-agv/runtime.env
ExecStart=/usr/bin/bash %h/.config/orange-agv/web-service.sh
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=25
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
