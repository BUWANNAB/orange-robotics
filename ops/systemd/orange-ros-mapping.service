[Unit]
Description=Orange on-demand SLAM controller
BindsTo=orange-ros-core.service
After=orange-ros-core.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/orange-agv/runtime.env
ExecStart=/usr/bin/bash %h/.config/orange-agv/ros-service.sh mapping
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=25
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
