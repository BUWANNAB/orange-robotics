[Unit]
Description=Orange verified Modbus PLC communication
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=%h/.config/orange-agv/runtime.env
ExecStart=/usr/bin/bash %h/.config/orange-agv/ros-service.sh plc
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=25
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
