# Merge into your local .env; never commit real keys or database passwords.
USE_SQLITE_DEV=true
RCS_DATABASE_URL=sqlite+aiosqlite:///./dev_agv.db
RCS_AUTO_SCHEMA=true
RCS_WORKER_ENABLED=true
# Production: ENVIRONMENT=production and a long randomly generated JWT_SECRET.
# JWT_SECRET is also used to encrypt WMS application secrets. Back it up securely.
# RCS_DATA_DIR=/var/lib/orange-agv/rcs
# RCS_CALLBACK_HOSTS=wms.example.com
# RCS_PERMISSIONS={"admin":["*"],"operator":["monitor:view","robot:view","robot:control","battery:view","alarm:view","alarm:handle","task:view","task:edit","map:view","dashboard:view"]}

# Real ROS: source /opt/ros/humble/setup.bash before starting one backend worker.
SIMULATION_MODE=false
# RCS_LOCAL_ROBOT_ID=1
# ROBOT_PCD_DIR=/var/lib/orange-agv/pcd
# ROS_MAP_CATALOG=/etc/orange-agv/localization-maps.json
ROS_MAP_FRAME=map
ROS_MAX_FITNESS=0.5
ROS_MAX_ROUTE_SPEED=0.3
ROS_BATTERY_STATE_TOPIC=/battery_state

# Map workbench: same directories as build_map_manager; one backend worker.
# ROBOT_MAP_DIR=/var/lib/orange-agv/maps
# ROS_LOCALIZATION_NODE=/lidar_localization
# PCD_PROCESSOR_EXECUTABLE=/path/to/orange_nav_ws/install/pcd2pgm/lib/pcd2pgm/map_asset_processor

# Enable only after deploying the three fixed systemd USER services on Linux.
# Same user / ROS_DOMAIN_ID / workspace as the Web process; keep one backend worker.
RCS_ROS_CONTROL_ENABLED=false
# Maintenance permissions: ros:view and ros:maintain (admin has both through *).
